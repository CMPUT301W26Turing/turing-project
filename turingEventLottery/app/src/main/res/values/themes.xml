<resources
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="Base.Theme.TuringEventLottery" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/primaryBackground</item>
        <item name="android:textColor">@color/black</item>
        <item name="materialButtonStyle">@style/DefaultButtonLook</item>
        <item name="materialCardViewStyle">@style/DefaultCardLook</item>
        <item name="android:fontFamily">@font/font_family</item>
        <item name="fontFamily">@font/font_family</item>
    </style>

    <style name="Theme.TuringEventLottery" parent="Base.Theme.TuringEventLottery" />

    <style name="ViewHeader">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/headerText</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DefaultButtonLook" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="DefaultCardLook" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/clickableCardsAndSpinners</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:padding">16dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <style name="CircularButtonStyleIconOnly" parent="Widget.Material3.Button">
        <item name="android:padding">0dp</item>
        <item name="android:textSize">0sp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/headerText</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconPadding">0dp</item>
        <item name="backgroundTint">@color/primaryBackground</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>