<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Blue Header with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primaryBlue"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                app:icon="@drawable/outline_arrow_back_ios_new_24"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORGANIZER DETAILS"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_semibold"
                android:alpha="0.8"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review and Manage"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Content Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NAME"
                            android:textSize="12sp"
                            android:textColor="@color/darkGray"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/organizerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Organizer Name"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/headerText"
                            android:layout_marginTop="4dp" />

                        <!-- ID -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ORGANIZER ID"
                            android:textSize="12sp"
                            android:textColor="@color/darkGray"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:id="@+id/organizerId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ID"
                            android:textSize="14sp"
                            android:textColor="@color/headerText"
                            android:layout_marginTop="4dp"
                            android:textIsSelectable="true"
 />

                        <!-- Email -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMAIL"
                            android:textSize="12sp"
                            android:textColor="@color/darkGray"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:id="@+id/organizerEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="email@example.com"
                            android:textSize="14sp"
                            android:textColor="@color/headerText"
                            android:layout_marginTop="4dp"
 />

                        <!-- Status Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS"
                                android:textSize="12sp"
                                android:textColor="@color/darkGray"
                                android:fontFamily="@font/poppins_semibold" />
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/organizerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:layout_marginTop="8dp"
                            app:chipBackgroundColor="@color/primaryBlue"
                            android:textColor="@color/white"
                            android:enabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Warning Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/box_background_event_details"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/baseline_warning_24"
                        app:tint="@color/orangeIconTint"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Removing this organizer"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/orangeIconTint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="They will be banned and cannot create or manage events"
                            android:textSize="12sp"
                            android:textColor="@color/darkGray"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Remove Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/primaryBackground">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeOrganizerButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/red"
                android:text="Remove Organizer"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="8dp"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
