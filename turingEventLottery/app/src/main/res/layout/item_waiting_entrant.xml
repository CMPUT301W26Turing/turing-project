<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/entrantAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="#FCE4EC"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/avatarText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="AF"
            android:textColor="#D81B60"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/entrantName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Alice Freeman"
        android:textColor="@color/headerText"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/statusBadge"
        app:layout_constraintStart_toEndOf="@id/entrantAvatar"
        app:layout_constraintTop_toTopOf="@id/entrantAvatar" />

    <TextView
        android:id="@+id/entrantDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Applied 2h ago • standard_ticket"
        android:textColor="@color/headerSubtext"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@+id/statusBadge"
        app:layout_constraintStart_toStartOf="@id/entrantName"
        app:layout_constraintTop_toBottomOf="@id/entrantName" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="#FFF8E1"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/moreButton"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Pending"
            android:textColor="#F57F17"
            android:textSize="10sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/moreButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/baseline_more_vert_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/headerSubtext" />

</androidx.constraintlayout.widget.ConstraintLayout>
