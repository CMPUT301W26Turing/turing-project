<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        style="@style/CircularButtonStyleIconOnly"
        app:icon="@drawable/outline_arrow_back_ios_new_24"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/myProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_amp_preferences"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profilePictureContainer"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myProfileTitle"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/profilePictureBorder"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:src="@drawable/circle_border_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePicture"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/baseline_person_24"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/editProfilePictureButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:backgroundTint="@color/primaryBlue"
            app:layout_constraintBottom_toBottomOf="@id/profilePicture"
            app:layout_constraintEnd_toEndOf="@id/profilePicture" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/headerText"
        app:layout_constraintTop_toBottomOf="@id/profilePictureContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/profileUserId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User ID: #12345"
        android:textSize="16sp"
        android:textColor="@color/headerSubtext"
        app:layout_constraintTop_toBottomOf="@id/profileName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profileDetailsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:backgroundTint="@color/secondaryBackground"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/profileUserId">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/profileDetailsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_person_24"
                    app:tint="@color/primaryBlue"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/profileDetailsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FULL NAME"
                    android:textSize="14sp"
                    android:textColor="@color/headerSubtext"
                    android:layout_marginStart="24dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fullNameBox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/box_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/fullNameValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        android:hint="Full Name"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/fullNameEditIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:gravity="center_vertical" />

                    <ImageView
                        android:id="@+id/fullNameEditIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/placeholder_image"
                        app:tint="@color/headerSubtext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL ADDRESS"
                    android:textSize="14sp"
                    android:textColor="@color/headerSubtext"
                    android:layout_marginStart="24dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/emailBox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/box_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/emailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="john.doe@example.com"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/emailEditIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:gravity="center_vertical" />

                    <ImageView
                        android:id="@+id/emailEditIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_mail_24"
                        app:tint="@color/headerSubtext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE NUMBER"
                    android:textSize="14sp"
                    android:textColor="@color/headerSubtext"
                    android:layout_marginStart="24dp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/phoneBox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/box_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/phoneValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="(555) 123-4567"
                        android:hint="Phone Number"
                        android:inputType="phone"
                        android:singleLine="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/phoneEditIcon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:gravity="center_vertical" />

                    <ImageView
                        android:id="@+id/phoneEditIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_call_24"
                        app:tint="@color/headerSubtext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Profile"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:backgroundTint="@color/primaryBlue"
        app:layout_constraintTop_toBottomOf="@id/profileDetailsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>