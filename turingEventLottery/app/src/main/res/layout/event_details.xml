<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:clickable="true"
        android:focusable="true"
        app:icon="@drawable/outline_arrow_back_ios_new_24"
        app:iconTint="@color/black"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/eventDetailsTitle"
        style="@style/ViewHeader"
        android:text="Event Details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/eventDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/eventDetailsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/waitlistButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/eventPoster"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image"/>

            <TextView
                android:id="@+id/eventName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Event Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingLeft="16dp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/eventLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Location"
                android:textSize="16sp"
                android:textColor="@color/darkGray"
                android:drawableStart="@drawable/baseline_location_on_24"
                android:drawableTint="@color/darkGray"
                android:paddingLeft="16dp"
                android:layout_marginTop="6dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dateTimeBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/box_background_event_details"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/dateTimeIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/outline_calendar_month_24"
                    android:scaleType="center"
                    app:tint="@color/primaryBlue"
                    android:background="@drawable/dark_blue_icon_background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/eventDateTimeBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE &amp; TIME"
                    android:textSize="12sp"
                    android:textColor="@color/darkGray"
                    android:paddingLeft="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/dateTimeIcon"
                    app:layout_constraintTop_toTopOf="@id/dateTimeBox"/>

                <TextView
                    android:id="@+id/eventDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date • Time"
                    android:textSize="16sp"
                    android:paddingLeft="16dp"
                    app:layout_constraintTop_toBottomOf="@id/eventDateTimeBoxTitle"
                    app:layout_constraintStart_toEndOf="@id/dateTimeIcon" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/demandBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/box_background_event_details"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/demandIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_groups_24"
                    android:scaleType="center"
                    app:tint="@color/orangeIconTint"
                    android:background="@drawable/orange_icon_background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/demandBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Demand"
                    android:textSize="12sp"
                    android:textColor="@color/darkGray"
                    android:paddingLeft="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/demandIcon"
                    app:layout_constraintTop_toTopOf="@id/demandBox"/>

                <TextView
                    android:id="@+id/demandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="###"
                    android:textSize="16sp"
                    android:paddingLeft="16dp"
                    app:layout_constraintTop_toBottomOf="@id/demandBoxTitle"
                    app:layout_constraintStart_toEndOf="@id/demandIcon" />

                <TextView
                    android:id="@+id/demandTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="waiting"
                    android:textSize="12sp"
                    android:textColor="@color/darkGray"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toEndOf="@id/demandTotal"
                    app:layout_constraintTop_toBottomOf="@id/demandBoxTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/organizerBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/box_background_event_details"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/organizerIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_person_24"
                    android:scaleType="center"
                    app:tint="@color/greenIconTint"
                    android:background="@drawable/green_icon_background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/organizerBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORGANIZER"
                    android:textSize="12sp"
                    android:textColor="@color/darkGray"
                    android:paddingLeft="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/organizerIcon"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/organizerId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textIsSelectable="true"
                    app:layout_constraintTop_toBottomOf="@id/organizerBoxTitle"
                    app:layout_constraintStart_toEndOf="@id/organizerIcon"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/eventDescriptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Event"
                android:textSize="18sp"
                android:paddingLeft="16dp"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/eventDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/darkGray"
                android:paddingLeft="16dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/red"
            android:text="Delete Event"
            android:textColor="@color/white"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/waitlistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primaryBlue"
            android:text="Join Waitlist"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
