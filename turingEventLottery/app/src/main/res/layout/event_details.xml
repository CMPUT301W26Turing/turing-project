<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_marginTop="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:clickable="true"
        android:focusable="true"
        app:icon="@drawable/outline_arrow_back_ios_new_24"
        app:iconTint="@color/black"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/eventDetailsTitle"
        style="@style/ViewHeader"
        android:text="Event Details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/eventDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/eventDetailsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/eventPoster"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image"/>

            <TextView
                android:id="@+id/eventName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingLeft="20dp"
                android:text="Event Name"
                android:textColor="@color/headerText"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eventLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="16sp"
                android:textColor="@color/darkGray"
                android:drawableStart="@drawable/baseline_location_on_24"
                android:drawableTint="@color/darkGray"
                android:paddingLeft="16dp"
                android:layout_marginTop="6dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dateTimeBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/box_background_event_details"
                android:elevation="1dp">

                <ImageView
                    android:id="@+id/dateTimeIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/light_blue_icon_background"
                    android:scaleType="center"
                    android:src="@drawable/outline_calendar_month_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/primaryBlue" />

                <TextView
                    android:id="@+id/eventDateTimeBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="16dp"
                    android:text="DATE &amp; TIME"
                    android:textColor="@color/darkGray"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/dateTimeIcon"
                    app:layout_constraintTop_toTopOf="@id/dateTimeBox" />

                <TextView
                    android:id="@+id/eventDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:text="Date • Time"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/dateTimeIcon"
                    app:layout_constraintTop_toBottomOf="@id/eventDateTimeBoxTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/demandBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/box_background_event_details"
                android:elevation="1dp">

                <ImageView
                    android:id="@+id/demandIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/orange_icon_background"
                    android:scaleType="center"
                    android:src="@drawable/baseline_groups_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/orangeIconTint" />

                <TextView
                    android:id="@+id/demandBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingLeft="16dp"
                    android:text="Current Demand"
                    android:textColor="@color/darkGray"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/demandIcon"
                    app:layout_constraintTop_toTopOf="@id/demandBox" />

                <TextView
                    android:id="@+id/demandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:text="###"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@id/demandIcon"
                    app:layout_constraintTop_toBottomOf="@id/demandBoxTitle" />

                <TextView
                    android:id="@+id/demandTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:text="waiting"
                    android:textColor="@color/darkGray"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@id/demandTotal"
                    app:layout_constraintTop_toBottomOf="@id/demandBoxTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/drawInfoTrigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/baseline_error_outline_24"
                    app:tint="@color/primaryBlue"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/draw_information"
                    android:textSize="13sp"
                    android:textColor="@color/primaryBlue"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/drawInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/secondaryBlue" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/exclamation_image"
                            android:src="@drawable/outline_emoji_people_24"
                            app:tint="@color/primaryBlue"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/how_the_lottery_draw_works"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/headerText"
                            android:layout_marginStart="8dp" />

                        <ImageButton
                            android:id="@+id/drawInfoCloseButton"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@string/draw_info_close_button"
                            android:src="@drawable/baseline_close_24"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="@color/darkGray" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="@string/_1"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:background="@drawable/circle_primary_blue"
                            android:layout_marginTop="1dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/join_the_waitlist"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/headerText" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sign_up_for_the_waitlist_before_the_draw_closes_all_participants_on_the_waitlist_are_eligible_to_be_selected"
                        android:textSize="13sp"
                        android:textColor="@color/darkGray"
                        android:paddingStart="34dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="@string/_2"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:background="@drawable/circle_primary_blue"
                            android:layout_marginTop="1dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/random_selection"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/headerText" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/when_the_draw_closes_entrants_are_selected_at_random_every_participant_in_the_waitlist_as_an_equal_chance_and_does_not_depend_on_when_they_joined"
                        android:textSize="13sp"
                        android:textColor="@color/darkGray"
                        android:paddingStart="34dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="@string/_3"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:background="@drawable/circle_primary_blue"
                            android:layout_marginTop="1dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/notification"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/headerText" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/selected_entrants_will_be_notified_via_the_app_you_ll_have_a_limited_time_to_confirm_your_spot_before_it_s_offered_to_the_next_entrant"
                        android:textSize="13sp"
                        android:textColor="@color/darkGray"
                        android:paddingStart="34dp"
                        android:layout_marginBottom="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/organizerBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/box_background_event_details"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/organizerIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_person_24"
                    android:scaleType="center"
                    app:tint="@color/greenIconTint"
                    android:background="@drawable/green_icon_background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp" />

                <TextView
                    android:id="@+id/organizerBoxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORGANIZER"
                    android:textSize="12sp"
                    android:textColor="@color/darkGray"
                    android:paddingLeft="16dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toEndOf="@id/organizerIcon"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/organizerId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textIsSelectable="true"
                    app:layout_constraintTop_toBottomOf="@id/organizerBoxTitle"
                    app:layout_constraintStart_toEndOf="@id/organizerIcon"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/eventDescriptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Event"
                android:textSize="18sp"
                android:paddingLeft="16dp"
                android:layout_marginTop="16dp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/eventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textColor="@color/darkGray"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#DDDDDD" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <TextView
                    android:id="@+id/commentsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comments"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>

                <ImageButton
                    android:id="@+id/sortCommentsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/outline_filter_list_24"
                    app:tint="@color/darkGray" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/commentsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/replyPreviewArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/replyingToText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Replying to User"
                android:textSize="12sp"
                android:textColor="@color/primaryBlue" />

            <ImageButton
                android:id="@+id/cancelReplyButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/baseline_close_24"
                app:tint="@color/darkGray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commentInputArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/commentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Write a comment..."
                android:background="@drawable/box_background_event_details"
                android:padding="12dp"
                android:textSize="14sp"/>

            <ImageButton
                android:id="@+id/postCommentButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/baseline_send_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/primaryBlue"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/red"
            android:text="Delete Event"
            android:textColor="@color/white"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/waitlistButton"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/primaryBlue"
            android:text="Join Waitlist"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
